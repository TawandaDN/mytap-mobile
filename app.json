{
  "expo": {
    "name": "MyTap",
    "slug": "mytap",
    "version": "2.0.0",
    "orientation": "portrait",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "mytap",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F1729"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mytap.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F1729"
      },
      "package": "com.mytap.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-asset",
      "expo-sharing",
      "expo-local-authentication",
      "expo-file-system"
    ],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/sites/adcbabb1-a3a6-4884-8540-7d8671c22b54/webpages/mytap"
    }
  }
}
